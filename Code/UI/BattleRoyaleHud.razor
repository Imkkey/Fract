@using System
@using System.Collections.Generic
@using Sandbox
@using Sandbox.UI
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( LocalPlayer is not null )
	{
		<div class="hud">
			<div class="crosshair"></div>

			@if ( LocalCharacter is null || !LocalCharacter.HasSelectedCharacter )
			{
				<div class="picker">
					<div class="title">Choose fighter</div>
					<div class="actions">
						<button onclick="@(() => LocalCharacter?.RequestSelectCharacter(CharacterId.Cardveil))">
							Cardveil
						</button>
						<button onclick="@(() => LocalCharacter?.RequestSelectCharacter(CharacterId.ClubBrawler))">
							Club Brawler
						</button>
						<button onclick="@(() => LocalCharacter?.RequestSelectCharacter(CharacterId.Mycell))">
							Mycell
						</button>
						<button onclick="@(() => LocalCharacter?.RequestSelectCharacter(CharacterId.Valtryek))">
							Valtryek
						</button>
					</div>
				</div>
			}
			else
			{
				<div class="status">
					<div class="health-widget">
						<div class="figma-health">
							<div class="figma-health-shell">
								<img class="figma-health-bg" src="ui/hp_bg.png" />
								<div class="figma-health-damage-mask" style="@DamageHealthFillStyle">
									<img class="figma-health-damage-fill" src="ui/hp_fill_damage.png" />
								</div>
								<div class="figma-health-fill-mask" style="@HealthFillStyle">
									<img class="figma-health-fill" src="ui/hp_fill.png" />
								</div>
								<img class="figma-health-frame" src="ui/hp_frame.png" />
								<div class="figma-health-small">@DamageBonusText</div>
							</div>
							<div class="figma-health-readout">
								<div class="figma-health-value">@MathF.Ceiling(LocalCombat.Health)</div>
								<div class="figma-health-max">/@MathF.Ceiling(LocalCombat.MaxHealth)</div>
							</div>
						</div>
					</div>

					<div class="buffs">
						<div>Phys +@MathF.Ceiling(LocalCombat.PhysicalDamageBonusPercent)%</div>
						<div>Magic +@MathF.Ceiling(LocalCombat.MagicDamageBonusPercent)%</div>
					</div>

				</div>

				<div class="skill-bar">
					@if ( LocalCharacter.CurrentCharacter == CharacterId.Cardveil )
					{
						<div class="skill-slot">
							<div class="skill-inner-shadow"></div>
							<img class="skill-icon" src="ui/skills/cardvile/CardvileS1.png" />
							@if ( ShuffleDashCooldownPercent > 0f )
							{
								<div class="skill-cooldown-mask" style="@ShuffleDashCooldownStyle"></div>
								<div class="skill-cooldown-text">@ShuffleDashCooldownText</div>
							}
							@if ( CardAttack?.IsShuffleDashBuffActive ?? false )
							{
								<div class="skill-load-text">BOOST</div>
							}
							<div class="skill-key">Q</div>
							<div class="skill-tooltip">
								<div class="skill-tooltip-header">
									<div class="skill-tooltip-title">Shuffle Dash</div>
									<div class="skill-tooltip-badge active">Active</div>
								</div>
								<div class="skill-tooltip-desc">Dash in your movement direction. If no key is held, dash forward.</div>
								<div class="skill-tooltip-section">Stats</div>
								<div class="skill-tooltip-row"><span>Cooldown</span><b>@FormatNumber(CardAttack?.ShuffleDashCooldown ?? 0f)s</b></div>
								<div class="skill-tooltip-row"><span>Distance</span><b>@FormatNumber(CardAttack?.ShuffleDashDistance ?? 0f)</b></div>
								<div class="skill-tooltip-section">After Dash</div>
								<div class="skill-tooltip-row"><span>Duration</span><b>@FormatNumber(CardAttack?.ShuffleDashBuffDuration ?? 0f)s</b></div>
								<div class="skill-tooltip-row"><span>Cards</span><b>+@FormatPercent(CardAttack?.ShuffleDashCardSpeedMultiplier ?? 1f) speed / +@FormatPercent(CardAttack?.ShuffleDashCardRangeMultiplier ?? 1f) range</b></div>
							</div>
						</div>
						<div class="skill-slot">
							<div class="skill-inner-shadow"></div>
							<img class="skill-icon" src="ui/skills/cardvile/CardvileS2.png" />
							@if ( MarkedDeckCooldownPercent > 0f )
							{
								<div class="skill-cooldown-mask" style="@MarkedDeckCooldownStyle"></div>
								<div class="skill-cooldown-text">@MarkedDeckCooldownText</div>
							}
							<div class="skill-tooltip">
								<div class="skill-tooltip-header">
									<div class="skill-tooltip-title">Marked Deck</div>
									<div class="skill-tooltip-badge passive">Passive</div>
								</div>
								<div class="skill-tooltip-desc">Automatically charges one random card in your next throw as a golden card.</div>
								<div class="skill-tooltip-section">Stats</div>
								<div class="skill-tooltip-row"><span>Charge time</span><b>@FormatNumber(CardAttack?.MarkedDeckPassiveInterval ?? 0f)s</b></div>
								<div class="skill-tooltip-row"><span>Golden card</span><b>+@FormatPercent(CardAttack?.MarkedDeckPhysicalDamageMultiplier ?? 1f) physical damage</b></div>
								<div class="skill-tooltip-section">On Hit</div>
								<div class="skill-tooltip-row"><span>Reveal</span><b>@FormatNumber(CardAttack?.MarkedDeckRevealDuration ?? 0f)s</b></div>
								<div class="skill-tooltip-note">Reveal is visible only to Cardveil.</div>
							</div>
						</div>
						<div class="skill-slot">
							<div class="skill-inner-shadow"></div>
							<img class="skill-icon" src="ui/skills/cardvile/CardvileS3.png" />
							@if ( CardAttack?.IsLoadedHandPanelOpen ?? false )
							{
								<div class="loaded-hand-panel">
									<div class="loaded-hand-title">@LoadedHandName</div>
									<div class="loaded-hand-type">@LoadedHandType</div>
								</div>
							}
							<div class="skill-key">R</div>
							<div class="skill-tooltip">
								<div class="skill-tooltip-header">
									<div class="skill-tooltip-title">Loaded Hand</div>
									<div class="skill-tooltip-badge active">Ultimate</div>
								</div>
								<div class="skill-tooltip-desc">Press R to cycle the card that empowers your next Marked Deck.</div>
								<div class="skill-tooltip-section">Selected</div>
								<div class="skill-tooltip-row"><span>Card</span><b>@LoadedHandName</b></div>
								<div class="skill-tooltip-row"><span>Type</span><b>@LoadedHandType</b></div>
								<div class="skill-tooltip-section">Effect</div>
								<div class="skill-tooltip-note">@LoadedHandDescription</div>
							</div>
						</div>
					}
					else
					{
						@for ( var i = 0; i < 3; i++ )
						{
							<div class="skill-slot @GetPlaceholderSkillSlotClass(i)">
								<div class="skill-inner-shadow"></div>
								@if ( HasPlaceholderSkillIcon(i) )
								{
									<img class="skill-icon" src="@GetPlaceholderSkillIconPath(i)" />
								}
								else
								{
									<div class="skill-placeholder-icon">@GetPlaceholderSkillLabel(i)</div>
								}
								@if ( GetPlaceholderCooldownPercent( i ) > 0f )
								{
									<div class="skill-cooldown-mask" style="@GetPlaceholderCooldownStyle(i)"></div>
									<div class="skill-cooldown-text">@GetPlaceholderCooldownText(i)</div>
								}
								@if ( ShouldShowPlaceholderSkillKey( i ) )
								{
									<div class="skill-key">@GetPlaceholderSkillKey(i)</div>
								}
								<div class="skill-tooltip">
									<div class="skill-tooltip-header">
										<div class="skill-tooltip-title">@GetPlaceholderSkillName(i)</div>
										<div class="skill-tooltip-badge @GetPlaceholderSkillBadgeClass(i)">@GetPlaceholderSkillBadgeText(i)</div>
									</div>
									<div class="skill-tooltip-desc">@GetPlaceholderSkillDescription(i)</div>
									@if ( HasPlaceholderSkillStats(i) )
									{
										<div class="skill-tooltip-section">Stats</div>
										@foreach ( var row in GetPlaceholderSkillStats(i) )
										{
											<div class="skill-tooltip-row"><span>@row.Split('|')[0]</span><b>@row.Split('|')[1]</b></div>
										}
									}
									else
									{
										<div class="skill-tooltip-note">Icon and ability logic will be added later.</div>
									}
								</div>
							</div>
						}
					}
				</div>
			}

			@if ( Match is not null )
			{
				<div class="match">
					@if ( Match.MatchFinished )
					{
						<div>Winner: @Match.WinnerName</div>
					}
					else
					{
						<div>Alive: @Match.AlivePlayers</div>
					}
				</div>
			}
		</div>
	}
</root>

@code
{
	PlayerCombat LocalCombat { get; set; }
	PlayerCharacter LocalCharacter { get; set; }
	CardAttack CardAttack { get; set; }
	MycellAttack MycellAttack { get; set; }
	PlayerCombat LocalPlayer => LocalCombat;
	BattleRoyaleMatch Match => BattleRoyaleMatch.Current;
	const float DamageBarDelay = 0.22f;
	const float DamageBarDuration = 0.45f;
	float DamageHealthPercent { get; set; } = -1f;
	float PreviousHealthPercent { get; set; } = -1f;
	float DamageAnimationStartPercent { get; set; }
	float DamageAnimationTargetPercent { get; set; }
	float DamageAnimationDelayRemaining { get; set; }
	float DamageAnimationElapsed { get; set; }
	bool DamageAnimationActive { get; set; }
	float HealthPercent => LocalCombat is null || LocalCombat.MaxHealth <= 0f ? 0f : (LocalCombat.Health / LocalCombat.MaxHealth * 100f).Clamp( 0f, 100f );
	string HealthFillStyle => $"height: {HealthPercent:0.##}%;";
	string DamageHealthFillStyle => $"height: {GetDamageHealthPercent():0.##}%;";
	string DamageBonusText => LocalCombat is null ? "0" : $"{LocalCombat.PhysicalDamageBonusPercent / 10f:0.#}";
	float ShuffleDashCooldownPercent => CardAttack?.ShuffleDashCooldownPercent ?? 0f;
	string ShuffleDashCooldownStyle => $"height: {ShuffleDashCooldownPercent:0.##}%;";
	string ShuffleDashCooldownText => CardAttack is null || CardAttack.ShuffleDashCooldownRemaining <= 0f
		? ""
		: $"{MathF.Ceiling( CardAttack.ShuffleDashCooldownRemaining )}";
	float MarkedDeckCooldownPercent => CardAttack?.MarkedDeckPassiveCooldownPercent ?? 0f;
	string MarkedDeckCooldownStyle => $"height: {MarkedDeckCooldownPercent:0.##}%;";
	string MarkedDeckCooldownText => CardAttack is null || CardAttack.MarkedDeckPassiveCooldownRemaining <= 0f
		? ""
		: $"{MathF.Ceiling( CardAttack.MarkedDeckPassiveCooldownRemaining )}";
	float MycellSkill1CooldownPercent => MycellAttack?.MushroomStepCooldownPercent ?? 0f;
	string MycellSkill1CooldownStyle => $"height: {MycellSkill1CooldownPercent:0.##}%;";
	string MycellSkill1CooldownText => MycellAttack is null || MycellAttack.MushroomStepCooldownRemaining <= 0f
		? ""
		: $"{MathF.Ceiling( MycellAttack.MushroomStepCooldownRemaining )}";
	float MycellSkill2CooldownPercent => MycellAttack?.RottenHealCooldownPercent ?? 0f;
	string MycellSkill2CooldownText => MycellAttack is null || MycellAttack.RottenHealCooldownRemaining <= 0f
		? ""
		: $"{MathF.Ceiling( MycellAttack.RottenHealCooldownRemaining )}";
	float MycellUltimateCooldownPercent => MycellAttack?.SporePitCooldownPercent ?? 0f;
	string MycellUltimateCooldownText => MycellAttack is null || MycellAttack.SporePitCooldownRemaining <= 0f
		? ""
		: $"{MathF.Ceiling( MycellAttack.SporePitCooldownRemaining )}";
	LoadedHandCard CurrentLoadedHandCard => CardAttack?.DisplayLoadedHandCard ?? LoadedHandCard.Eye;
	string LoadedHandName => CurrentLoadedHandCard switch
	{
		LoadedHandCard.Blood => "Blood Card",
		LoadedHandCard.Ace => "Ace Card",
		_ => "Eye Card"
	};
	string LoadedHandType => CurrentLoadedHandCard switch
	{
		LoadedHandCard.Blood => "Bleed + Heal",
		LoadedHandCard.Ace => "Combo Damage",
		_ => "Reveal + Trail"
	};
	string LoadedHandDescription => CurrentLoadedHandCard switch
	{
		LoadedHandCard.Blood => "Marked Deck deals less direct damage, applies bleed, and returns part of bleed damage as healing.",
		LoadedHandCard.Ace => "Marked Deck deals bonus magic damage if the target already has Bleed Luck.",
		_ => "Marked Deck reveals the target and shows a short movement trail for tracking."
	};
	string CurrentCharacterName => LocalCharacter?.CurrentCharacter switch
	{
		CharacterId.ClubBrawler => "Club Brawler",
		CharacterId.Mycell => "Mycell",
		CharacterId.Valtryek => "Valtryek",
		CharacterId.Cardveil => "Cardveil",
		_ => "Character"
	};
	string GetPlaceholderSkillKey( int index ) => index switch
	{
		0 => "Q",
		1 => "E",
		2 => "R",
		_ => ""
	};
	bool ShouldShowPlaceholderSkillKey( int index ) => !IsPlaceholderPassiveSkill( index ) && !string.IsNullOrWhiteSpace( GetPlaceholderSkillKey( index ) );
	bool IsPlaceholderPassiveSkill( int index ) => false;
	string GetPlaceholderSkillSlotClass( int index )
	{
		if ( LocalCharacter?.CurrentCharacter is CharacterId.Mycell or CharacterId.Valtryek )
			return "";

		return "locked";
	}
	string GetPlaceholderSkillLabel( int index ) => index switch
	{
		0 => "S1",
		1 => "S2",
		2 => "ULT",
		_ => "S"
	};
	bool HasPlaceholderSkillIcon( int index ) => !string.IsNullOrWhiteSpace( GetPlaceholderSkillIconPath( index ) );
	string GetPlaceholderSkillIconPath( int index )
	{
		if ( LocalCharacter?.CurrentCharacter == CharacterId.Mycell )
		{
			return index switch
			{
				0 => "ui/skills/mycell/MycellS1.png",
				1 => "ui/skills/mycell/MycellS2.png",
				2 => "ui/skills/mycell/MycellS3.png",
				_ => ""
			};
		}

		return "";
	}
	string GetPlaceholderSkillName( int index ) => index switch
	{
		0 when LocalCharacter?.CurrentCharacter == CharacterId.Mycell => "Mushroom Step",
		1 when LocalCharacter?.CurrentCharacter == CharacterId.Mycell => "Rotten Heal",
		2 when LocalCharacter?.CurrentCharacter == CharacterId.Mycell => "Spore Pit",
		0 when LocalCharacter?.CurrentCharacter == CharacterId.Valtryek => "Valtryek Skill 1",
		1 when LocalCharacter?.CurrentCharacter == CharacterId.Valtryek => "Valtryek Skill 2",
		2 when LocalCharacter?.CurrentCharacter == CharacterId.Valtryek => "Valtryek Ultimate",
		0 => $"{CurrentCharacterName} Skill 1",
		1 => $"{CurrentCharacterName} Skill 2",
		2 => $"{CurrentCharacterName} Ultimate",
		_ => $"{CurrentCharacterName} Skill"
	};
	string GetPlaceholderSkillDescription( int index ) => index switch
	{
		0 when LocalCharacter?.CurrentCharacter == CharacterId.Mycell => "Grow a mushroom under yourself, leap up and forward, and leave a trap behind.",
		1 when LocalCharacter?.CurrentCharacter == CharacterId.Mycell => "Consume nearby poison clouds to heal. Clouds that damaged enemies heal more.",
		2 when LocalCharacter?.CurrentCharacter == CharacterId.Mycell => "Create a huge toxic spore zone. Stay inside to keep it alive.",
		0 when LocalCharacter?.CurrentCharacter == CharacterId.Valtryek => "Coming soon.",
		1 when LocalCharacter?.CurrentCharacter == CharacterId.Valtryek => "Coming soon.",
		2 when LocalCharacter?.CurrentCharacter == CharacterId.Valtryek => "Coming soon.",
		0 => "Active ability placeholder.",
		1 => "Second ability placeholder.",
		2 => "Ultimate placeholder.",
		_ => "Ability placeholder."
	};
	string GetPlaceholderSkillBadgeText( int index ) => LocalCharacter?.CurrentCharacter == CharacterId.Valtryek && index == 2
		? "Ultimate"
		: LocalCharacter?.CurrentCharacter == CharacterId.Valtryek && index is 0 or 1
			? "Active"
		: LocalCharacter?.CurrentCharacter == CharacterId.Mycell && index == 2
		? "Ultimate"
		: LocalCharacter?.CurrentCharacter == CharacterId.Mycell && index is 0 or 1
			? "Active"
		: "Soon";
	string GetPlaceholderSkillBadgeClass( int index ) => LocalCharacter?.CurrentCharacter is CharacterId.Mycell or CharacterId.Valtryek
		? "active"
		: "locked";
	bool HasPlaceholderSkillStats( int index ) => LocalCharacter?.CurrentCharacter == CharacterId.Mycell;
	List<string> GetPlaceholderSkillStats( int index )
	{
		var rows = new List<string>();
		if ( LocalCharacter?.CurrentCharacter != CharacterId.Mycell || MycellAttack is null )
			return rows;

		if ( index == 0 )
		{
			rows.Add( $"Cooldown|{FormatNumber( MycellAttack.MushroomStepCooldown )}s" );
			rows.Add( $"Trap lifetime|{FormatNumber( MycellAttack.MushroomStepTrapLifetime )}s" );
			rows.Add( "Bounce|owner only" );
		}
		else if ( index == 1 )
		{
			rows.Add( $"Cooldown|{FormatNumber( MycellAttack.RottenHealCooldown )}s" );
			rows.Add( $"Radius|{FormatNumber( MycellAttack.RottenHealRadius / 100f )}m" );
			rows.Add( $"Clouds|up to {MycellAttack.RottenHealMaxClouds}" );
			rows.Add( $"Heal|{FormatNumber( MycellAttack.RottenHealAmount )}/{FormatNumber( MycellAttack.RottenHealEmpoweredAmount )} HP" );
			rows.Add( $"Speed|+{FormatPercent( MycellAttack.RottenHealMoveSpeedMultiplier )} for {FormatNumber( MycellAttack.RottenHealMoveSpeedDuration )}s" );
		}
		else if ( index == 2 )
		{
			rows.Add( $"Cooldown|{FormatNumber( MycellAttack.SporePitCooldown )}s" );
			rows.Add( $"Radius|{FormatNumber( MycellAttack.SporePitRadius / 100f )}m" );
			rows.Add( $"Duration|{FormatNumber( MycellAttack.SporePitDuration )}s" );
			rows.Add( $"Damage|{FormatNumber( MycellAttack.SporePitTickDamage )}/sec" );
			rows.Add( $"Enemy slow|{FormatPercent( MycellAttack.SporePitEnemySlowMultiplier )}" );
			rows.Add( $"Owner speed|+{FormatPercent( MycellAttack.SporePitOwnerMoveSpeedMultiplier )}" );
			rows.Add( $"Leave time|{FormatNumber( MycellAttack.SporePitExitGraceSeconds )}s" );
		}

		return rows;
	}
	float GetPlaceholderCooldownPercent( int index )
	{
		if ( LocalCharacter?.CurrentCharacter == CharacterId.Mycell && index == 0 )
			return MycellSkill1CooldownPercent;
		if ( LocalCharacter?.CurrentCharacter == CharacterId.Mycell && index == 1 )
			return MycellSkill2CooldownPercent;
		if ( LocalCharacter?.CurrentCharacter == CharacterId.Mycell && index == 2 )
			return MycellUltimateCooldownPercent;

		return 0f;
	}
	string GetPlaceholderCooldownStyle( int index ) => $"height: {GetPlaceholderCooldownPercent( index ):0.##}%;";
	string GetPlaceholderCooldownText( int index )
	{
		if ( LocalCharacter?.CurrentCharacter == CharacterId.Mycell && index == 0 )
			return MycellSkill1CooldownText;
		if ( LocalCharacter?.CurrentCharacter == CharacterId.Mycell && index == 1 )
			return MycellSkill2CooldownText;
		if ( LocalCharacter?.CurrentCharacter == CharacterId.Mycell && index == 2 )
			return MycellAttack?.IsSporePitActive ?? false ? "ON" : MycellUltimateCooldownText;

		return "";
	}

	string FormatNumber( float value )
	{
		return value.ToString( "0.##" );
	}

	string FormatPercent( float multiplier )
	{
		return MathF.Round( (multiplier - 1f) * 100f ).ToString( "0" ) + "%";
	}

	protected override void OnUpdate()
	{
		UpdateLocalPlayerRefs();
		UpdateDamageHealthBar();
	}

	protected override int BuildHash()
	{
		UpdateLocalPlayerRefs();

		var hash = new HashCode();
		hash.Add( LocalCombat?.Health ?? 0f );
		hash.Add( LocalCombat?.MaxHealth ?? 0f );
		hash.Add( MathF.Round( GetDamageHealthPercent(), 2 ) );
		hash.Add( LocalCombat?.PhysicalDamageBonusPercent ?? 0f );
		hash.Add( LocalCombat?.MagicDamageBonusPercent ?? 0f );
		hash.Add( LocalCharacter?.CurrentCharacter ?? CharacterId.None );
		hash.Add( CardAttack?.ShuffleDashCooldownRemaining ?? 0f );
		hash.Add( CardAttack?.MarkedDeckPassiveCooldownRemaining ?? 0f );
		hash.Add( CardAttack?.IsShuffleDashBuffActive ?? false );
		hash.Add( CardAttack?.IsMarkedDeckLoaded ?? false );
		hash.Add( CardAttack?.DisplayLoadedHandCard ?? LoadedHandCard.Eye );
		hash.Add( CardAttack?.IsLoadedHandPanelOpen ?? false );
		hash.Add( MycellAttack?.MushroomStepCooldownRemaining ?? 0f );
		hash.Add( MycellAttack?.RottenHealCooldownRemaining ?? 0f );
		hash.Add( MycellAttack?.SporePitCooldownRemaining ?? 0f );
		hash.Add( MycellAttack?.IsSporePitActive ?? false );
		hash.Add( Match?.AlivePlayers ?? 0 );
		hash.Add( Match?.MatchFinished ?? false );
		hash.Add( Match?.WinnerName ?? "" );

		return hash.ToHashCode();
	}

	void UpdateLocalPlayerRefs()
	{
		LocalCombat = Scene.GetAllComponents<PlayerCombat>()
			.FirstOrDefault( player => player.GameObject.Network.IsOwner );
		LocalCharacter = LocalCombat?.GetComponent<PlayerCharacter>();
		CardAttack = LocalCombat?.GetComponent<CardAttack>();
		MycellAttack = LocalCombat?.GetComponent<MycellAttack>();
	}

	float GetDamageHealthPercent()
	{
		return DamageHealthPercent < 0f ? HealthPercent : DamageHealthPercent.Clamp( 0f, 100f );
	}

	void UpdateDamageHealthBar()
	{
		if ( LocalCombat is null )
		{
			DamageHealthPercent = -1f;
			PreviousHealthPercent = -1f;
			DamageAnimationActive = false;
			return;
		}

		var targetPercent = HealthPercent;

		if ( DamageHealthPercent < 0f || PreviousHealthPercent < 0f )
		{
			DamageHealthPercent = targetPercent;
			PreviousHealthPercent = targetPercent;
			return;
		}

		if ( targetPercent > PreviousHealthPercent + 0.01f )
		{
			DamageHealthPercent = MathF.Max( DamageHealthPercent, targetPercent );
			DamageAnimationStartPercent = DamageHealthPercent;
			DamageAnimationTargetPercent = targetPercent;
			DamageAnimationActive = DamageHealthPercent > targetPercent + 0.01f;
			DamageAnimationDelayRemaining = DamageAnimationActive ? DamageBarDelay : 0f;
			DamageAnimationElapsed = 0f;
		}
		else if ( targetPercent < PreviousHealthPercent - 0.01f )
		{
			DamageHealthPercent = MathF.Max( DamageHealthPercent, PreviousHealthPercent );
			DamageAnimationStartPercent = DamageHealthPercent;
			DamageAnimationTargetPercent = targetPercent;
			DamageAnimationDelayRemaining = DamageBarDelay;
			DamageAnimationElapsed = 0f;
			DamageAnimationActive = true;
		}

		if ( DamageAnimationActive )
		{
			if ( DamageAnimationDelayRemaining > 0f )
			{
				DamageAnimationDelayRemaining = MathF.Max( 0f, DamageAnimationDelayRemaining - Time.Delta );
			}
			else
			{
				DamageAnimationElapsed += Time.Delta;
				var progress = (DamageAnimationElapsed / DamageBarDuration).Clamp( 0f, 1f );
				var easedProgress = progress * progress;
				DamageHealthPercent = DamageAnimationStartPercent + (DamageAnimationTargetPercent - DamageAnimationStartPercent) * easedProgress;

				if ( progress >= 1f )
				{
					DamageHealthPercent = DamageAnimationTargetPercent;
					DamageAnimationActive = false;
				}
			}
		}

		PreviousHealthPercent = targetPercent;
	}
}
