@using System
@using Sandbox
@using Sandbox.UI
@inherits PanelComponent
@namespace Sandbox

<root>
	@if ( LocalPlayer is not null )
	{
		<div class="hud">
			<div class="crosshair"></div>

			@if ( LocalCharacter is null || !LocalCharacter.HasSelectedCharacter )
			{
				<div class="picker">
					<div class="title">Choose fighter</div>
					<div class="actions">
						<button onclick="@(() => LocalCharacter?.RequestSelectCharacter(CharacterId.CardThrower))">
							Card Thrower
						</button>
						<button onclick="@(() => LocalCharacter?.RequestSelectCharacter(CharacterId.ClubBrawler))">
							Club Brawler
						</button>
					</div>
				</div>
			}
			else
			{
				<div class="status">
					<div class="health-widget">
						<div class="figma-health">
							<div class="figma-health-shell">
								<img class="figma-health-bg" src="ui/hp_bg.png" />
								<div class="figma-health-damage-mask" style="@DamageHealthFillStyle">
									<img class="figma-health-damage-fill" src="ui/hp_fill_damage.png" />
								</div>
								<div class="figma-health-fill-mask" style="@HealthFillStyle">
									<img class="figma-health-fill" src="ui/hp_fill.png" />
								</div>
								<img class="figma-health-frame" src="ui/hp_frame.png" />
								<div class="figma-health-small">@DamageBonusText</div>
							</div>
							<div class="figma-health-readout">
								<div class="figma-health-value">@MathF.Ceiling(LocalCombat.Health)</div>
								<div class="figma-health-max">/@MathF.Ceiling(LocalCombat.MaxHealth)</div>
							</div>
						</div>
					</div>

					<div class="buffs">
						<div>Phys +@MathF.Ceiling(LocalCombat.PhysicalDamageBonusPercent)%</div>
						<div>Magic +@MathF.Ceiling(LocalCombat.MagicDamageBonusPercent)%</div>
					</div>

				</div>
			}

			@if ( Match is not null )
			{
				<div class="match">
					@if ( Match.MatchFinished )
					{
						<div>Winner: @Match.WinnerName</div>
					}
					else
					{
						<div>Alive: @Match.AlivePlayers</div>
					}
				</div>
			}
		</div>
	}
</root>

@code
{
	PlayerCombat LocalCombat { get; set; }
	PlayerCharacter LocalCharacter { get; set; }
	PlayerCombat LocalPlayer => LocalCombat;
	BattleRoyaleMatch Match => BattleRoyaleMatch.Current;
	const float DamageBarDelay = 0.22f;
	const float DamageBarDuration = 0.45f;
	float DamageHealthPercent { get; set; } = -1f;
	float PreviousHealthPercent { get; set; } = -1f;
	float DamageAnimationStartPercent { get; set; }
	float DamageAnimationTargetPercent { get; set; }
	float DamageAnimationDelayRemaining { get; set; }
	float DamageAnimationElapsed { get; set; }
	bool DamageAnimationActive { get; set; }
	float HealthPercent => LocalCombat is null || LocalCombat.MaxHealth <= 0f ? 0f : (LocalCombat.Health / LocalCombat.MaxHealth * 100f).Clamp( 0f, 100f );
	string HealthFillStyle => $"height: {HealthPercent:0.##}%;";
	string DamageHealthFillStyle => $"height: {GetDamageHealthPercent():0.##}%;";
	string DamageBonusText => LocalCombat is null ? "0" : $"{LocalCombat.PhysicalDamageBonusPercent / 10f:0.#}";

	protected override void OnUpdate()
	{
		UpdateLocalPlayerRefs();
		UpdateDamageHealthBar();
	}

	protected override int BuildHash()
	{
		UpdateLocalPlayerRefs();

		var playerHash = HashCode.Combine(
			LocalCombat?.Health ?? 0f,
			LocalCombat?.MaxHealth ?? 0f,
			MathF.Round( GetDamageHealthPercent(), 2 ),
			LocalCombat?.PhysicalDamageBonusPercent ?? 0f,
			LocalCombat?.MagicDamageBonusPercent ?? 0f,
			LocalCharacter?.CurrentCharacter ?? CharacterId.None,
			Match?.AlivePlayers ?? 0,
			Match?.MatchFinished ?? false );

		return HashCode.Combine(
			playerHash,
			Match?.WinnerName ?? "" );
	}

	void UpdateLocalPlayerRefs()
	{
		LocalCombat = Scene.GetAllComponents<PlayerCombat>()
			.FirstOrDefault( player => player.GameObject.Network.IsOwner );
		LocalCharacter = LocalCombat?.GetComponent<PlayerCharacter>();
	}

	float GetDamageHealthPercent()
	{
		return DamageHealthPercent < 0f ? HealthPercent : DamageHealthPercent.Clamp( 0f, 100f );
	}

	void UpdateDamageHealthBar()
	{
		if ( LocalCombat is null )
		{
			DamageHealthPercent = -1f;
			PreviousHealthPercent = -1f;
			DamageAnimationActive = false;
			return;
		}

		var targetPercent = HealthPercent;

		if ( DamageHealthPercent < 0f || PreviousHealthPercent < 0f )
		{
			DamageHealthPercent = targetPercent;
			PreviousHealthPercent = targetPercent;
			return;
		}

		if ( targetPercent > PreviousHealthPercent + 0.01f )
		{
			DamageHealthPercent = MathF.Max( DamageHealthPercent, targetPercent );
			DamageAnimationStartPercent = DamageHealthPercent;
			DamageAnimationTargetPercent = targetPercent;
			DamageAnimationActive = DamageHealthPercent > targetPercent + 0.01f;
			DamageAnimationDelayRemaining = DamageAnimationActive ? DamageBarDelay : 0f;
			DamageAnimationElapsed = 0f;
		}
		else if ( targetPercent < PreviousHealthPercent - 0.01f )
		{
			DamageHealthPercent = MathF.Max( DamageHealthPercent, PreviousHealthPercent );
			DamageAnimationStartPercent = DamageHealthPercent;
			DamageAnimationTargetPercent = targetPercent;
			DamageAnimationDelayRemaining = DamageBarDelay;
			DamageAnimationElapsed = 0f;
			DamageAnimationActive = true;
		}

		if ( DamageAnimationActive )
		{
			if ( DamageAnimationDelayRemaining > 0f )
			{
				DamageAnimationDelayRemaining = MathF.Max( 0f, DamageAnimationDelayRemaining - Time.Delta );
			}
			else
			{
				DamageAnimationElapsed += Time.Delta;
				var progress = (DamageAnimationElapsed / DamageBarDuration).Clamp( 0f, 1f );
				var easedProgress = progress * progress;
				DamageHealthPercent = DamageAnimationStartPercent + (DamageAnimationTargetPercent - DamageAnimationStartPercent) * easedProgress;

				if ( progress >= 1f )
				{
					DamageHealthPercent = DamageAnimationTargetPercent;
					DamageAnimationActive = false;
				}
			}
		}

		PreviousHealthPercent = targetPercent;
	}
}
